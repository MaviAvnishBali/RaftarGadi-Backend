_Driver _$DriverFromJson(Map<String, dynamic> json) => _Driver(
  id: json['id'] as String,
  fullName: json['fullName'] as String,
  phone: json['phone'] as String,
  vehicle: Vehicle.fromJson(json['vehicle'] as Map<String, dynamic>),
  availability:
      $enumDecodeNullable(_$DriverAvailabilityEnumMap, json['availability']) ??
      DriverAvailability.offline,
  rating: (json['rating'] as num?)?.toDouble() ?? 0,
  totalTrips: (json['totalTrips'] as num?)?.toInt() ?? 0,
  photoUrl: json['photoUrl'] as String?,
);

Map<String, dynamic> _$DriverToJson(_Driver instance) => <String, dynamic>{
  'id': instance.id,
  'fullName': instance.fullName,
  'phone': instance.phone,
  'vehicle': instance.vehicle.toJson(),
  'availability': _$DriverAvailabilityEnumMap[instance.availability]!,
  'rating': instance.rating,
  'totalTrips': instance.totalTrips,
  'photoUrl': instance.photoUrl,
};

const _$DriverAvailabilityEnumMap = {
  DriverAvailability.offline: 'offline',
  DriverAvailability.online: 'online',
  DriverAvailability.onTrip: 'onTrip',
};
