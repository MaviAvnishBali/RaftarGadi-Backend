# ─── Application ───────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://raftargadi:raftargadi_dev@localhost:5432/raftargadi?schema=public

# ─── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-access-secret-change-me
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-me
JWT_REFRESH_EXPIRATION=30d

# ─── OTP ───────────────────────────────────────────────────
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_LENGTH=6

# ─── Rate Limiting ─────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ─── SMS Provider ─────────────────────────────────────────
SMS_PROVIDER=console
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=

# ─── Email Provider ───────────────────────────────────────
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@raftargadi.com

# ─── FCM (Firebase Cloud Messaging) ───────────────────────
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# ─── Payment Gateway ──────────────────────────────────────
PAYMENT_GATEWAY=mock
PAYMENT_API_KEY=
PAYMENT_API_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ─── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Driver Matching ──────────────────────────────────────
DRIVER_SEARCH_RADIUS_KM=5
DRIVER_SEARCH_MAX_RESULTS=20
DRIVER_REQUEST_TIMEOUT_SECONDS=30

# ─── Platform ─────────────────────────────────────────────
PLATFORM_COMMISSION_PERCENT=15
